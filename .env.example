# ============================================
# Personal AI OS - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ==================== 必需配置 ====================
# JWT 签名密钥（必须设置，不能使用默认值）
SECRET_KEY=your-secret-key-change-in-production

# PostgreSQL 密码（不能使用默认值）
POSTGRES_PASSWORD=your-postgres-password

# Redis 密码
REDIS_PASSWORD=your-redis-password

# ==================== AI 模型配置 ====================
# 提供商选择：siliconflow, deepseek, openai, local, auto
AI_PROVIDER=siliconflow

# SiliconFlow 配置（推荐，有免费额度）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key

# DeepSeek 配置（更便宜）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 语言模型
LLM_MODEL=deepseek-ai/DeepSeek-V3

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ==================== 开发环境配置 ====================
# 以下配置仅用于本地开发，不要在生产环境使用
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_ai_os
# REDIS_URL=redis://localhost:6379/0
# SECRET_KEY=dev-secret-key-only-for-local-development
