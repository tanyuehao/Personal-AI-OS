# Personal AI OS - 环境变量配置示例

# 应用配置
APP_NAME=Personal AI OS
APP_VERSION=0.1.0
DEBUG=true

# 数据库配置（canonical async URL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_ai_os
DATABASE_ECHO=false

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 认证配置
SECRET_KEY=your-super-secret-key-please-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== AI 模型配置 ====================
# 选择默认 AI 提供商: deepseek, mimo, openai, local, auto
AI_PROVIDER=deepseek

# ---------- DeepSeek 配置（推荐，便宜好用）----------
# 注册地址: https://platform.deepseek.com/
# 价格: ¥1/百万 tokens（输入），¥2/百万 tokens（输出）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 小米 MiMo 配置（通过 SiliconFlow）----------
# 注册地址: https://siliconflow.cn/
# 价格: 免费额度 + 超低价格
MIMO_API_KEY=sk-your-siliconflow-api-key
MIMO_API_BASE=https://api.siliconflow.cn/v1
MIMO_MODEL=XiaomiMiMo-7B-RL

# ---------- OpenAI 配置（可选）----------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 本地模型配置（Ollama）----------
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_BASE=http://localhost:11434/v1
LOCAL_MODEL_NAME=qwen2.5:7b

# ==================== Embedding 配置 ====================
# 选择 Embedding 提供商: siliconflow, openai, local
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ==================== 向量数据库配置 ====================
VECTOR_DB_TYPE=pgvector
QDRANT_URL=http://localhost:6333
